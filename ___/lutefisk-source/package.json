{
  "name": "lutefisk",
  "productName": "Lutefisk",
  "version": "1.0.0",
  "description": "Local-first book writing and formatting studio with live device previews.",
  "main": "dist/main.cjs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "start": "npm run build && electron .",
    "dev": "npm run build && LUTEFISK_DEV=1 electron .",
    "test": "node --test test/*.test.mjs",
    "audit": "npm audit --audit-level=low",
    "check:deprecated": "node scripts/check-deprecated.mjs",
    "sbom": "node scripts/sbom.mjs",
    "package": "npm run build:prod && node scripts/package.mjs",
    "package:mac": "npm run build:prod && node scripts/package.mjs --platform=darwin",
    "package:win": "npm run build:prod && node scripts/package.mjs --platform=win32",
    "package:linux": "npm run build:prod && node scripts/package.mjs --platform=linux"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "docx": "^9.15.3",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "temml": "^0.14.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
